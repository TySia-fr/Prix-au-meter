# PostgreSQL connection (app + import pipeline)
DATABASE_URL=postgresql://pam:pam@localhost:5432/pam
# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-string
# Public origin of the app (used for auth callbacks / CSRF origin checks)
BETTER_AUTH_URL=http://localhost:3000
# Map style (MapLibre). OpenFreeMap: free, no key, attribution required.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Géoplateforme geocoding API (IGN) — successor of api-adresse.data.gouv.fr
GEOCODER_URL=https://data.geopf.fr/geocodage
