    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "flatbush": "^4.7.0",
    "geist": "^1.9.2",
    "maplibre-gl": "^6.18.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
